{
  "name": "canyon-quickcut",
  "version": "1.1.0",
  "description": "面向长视频素材的本地快速剪辑器",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "build": "vite build",
    "start": "npm run build && electron .",
    "dev": "vite",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --win nsis portable --publish never",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "release": "npm run build && electron-builder --win nsis portable --publish always"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "cn.local.canyonquickcut",
    "productName": "峡谷快剪",
    "artifactName": "峡谷快剪-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/@ffmpeg-installer/win32-x64/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      },
      {
        "from": "node_modules/@ffprobe-installer/win32-x64/ffprobe.exe",
        "to": "bin/ffprobe.exe"
      }
    ],
    "win": {
      "target": [
        {
          "arch": [
            "x64"
          ],
          "target": "nsis"
        },
        {
          "arch": [
            "x64"
          ],
          "target": "portable"
        }
      ],
      "signAndEditExecutable": false
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release",
        "repo": "canyon-quickcut",
        "owner": "3272002347"
      }
    ],
    "generateUpdatesFilesForAllChannels": true,
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "峡谷快剪",
      "deleteAppDataOnUninstall": false,
      "artifactName": "峡谷快剪-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "峡谷快剪-Portable-${version}-${arch}.${ext}"
    }
  },
  "author": "Mikasa"
}
